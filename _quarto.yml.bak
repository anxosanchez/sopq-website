project:
  type: website
  output-dir: _site
  resources:
    - schedule.js

website:
  title: "SOPQ"
  navbar:
    background: primary
    search: true
    left:
      # Galego (Primary) Links
      - text: "SOPQ"
        href: index.qmd
      - text: "Guía Docente"
        href: gl/guia-docente.qmd
      - text: "Blog"
        href: gl/blog/index.qmd
      
      # Spanish Links
      - text: "SOPQ"
        href: es/index.qmd
      - text: "Guía Docente"
        href: es/guia-docente.qmd
      - text: "Blog"
        href: es/blog/index.qmd
      
      # English Links
      - text: "SOPQ"
        href: en/index.qmd
      - text: "Syllabus"
        href: en/guia-docente.qmd
      - text: "Blog"
        href: en/blog/index.qmd

    right:
      - text: "Galego"
        href: index.qmd
      - text: "Español"
        href: es/index.qmd
      - text: "English"
        href: en/index.qmd

format:
  html:
    theme:
      light: cosmo
      dark: superhero
    css: styles.css
    include-in-header:
      - text: |
          <script>
            (function() {
              // 1. Detect active language from URL path
              var path = window.location.pathname;
              var lang = 'gl';
              if (path.indexOf('/es/') !== -1) {
                lang = 'es';
              } else if (path.indexOf('/en/') !== -1) {
                lang = 'en';
              }
              document.documentElement.classList.add('lang-' + lang);
              document.documentElement.setAttribute('lang', lang);

              // 2. Compute project root relative path prefix dynamically
              var prefix = '';
              var scripts = document.getElementsByTagName('script');
              for (var i = 0; i < scripts.length; i++) {
                var src = scripts[i].getAttribute('src');
                if (src && src.indexOf('site_libs/') !== -1) {
                  prefix = src.substring(0, src.indexOf('site_libs/'));
                  break;
                }
              }
              
              // If we are at the root index page on local dev or simple server, the scripts might not have site_libs yet.
              // Let's also check path segment depth if prefix is still empty
              if (!prefix) {
                var segments = path.split('/').filter(Boolean);
                // If path ends with index.html, ignore last segment
                if (segments.length > 0 && segments[segments.length - 1].indexOf('.html') !== -1) {
                  segments.pop();
                }
                // Check if we are in a language subdirectory
                if (segments.length > 0 && (segments[0] === 'gl' || segments[0] === 'es' || segments[0] === 'en')) {
                  prefix = '../'.repeat(segments.length);
                }
              }

              window.SOPQ_PATH_PREFIX = prefix;

              // 3. Dynamically inject schedule.js with correct relative path
              var scriptEl = document.createElement('script');
              scriptEl.src = prefix + 'schedule.js';
              scriptEl.defer = true;
              document.head.appendChild(scriptEl);
            })();
          </script>
    include-after-body:
      - text: |
          <script>
            // Add custom active state classes to navbar links on load
            document.addEventListener("DOMContentLoaded", function() {
              var path = window.location.pathname;
              var navLinks = document.querySelectorAll('.navbar-nav .nav-link');
              navLinks.forEach(function(link) {
                var href = link.getAttribute('href');
                if (href) {
                  if (path.endsWith(href) || (href === 'index.html' && path.endsWith('/'))) {
                    link.classList.add('active');
                  }
                }
              });
            });
          </script>

execute:
  freeze: auto

editor: visual
